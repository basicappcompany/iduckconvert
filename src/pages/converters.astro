---
import AppShell from '../components/AppShell.astro';
import { TOOLS, TOOL_GROUPS, GROUP_EMOJI, hrefFor, toolsInGroup } from '../lib/tools';
import { breadcrumbLd, collectionLd } from '../lib/seo';

const description = `All ${TOOLS.length} free converters in one list: audio, video, images, spreadsheets and data, units, numbers, text and time zones. Everything runs in your browser.`;
---

<AppShell
  title="All converters: audio, video, data, units and more | iDuckConvert"
  description={description}
  jsonLd={[
    collectionLd('All converters', '/converters/', description, TOOLS.filter((t) => !t.site).map((t) => ({ name: t.name, path: `/${t.slug}/` }))),
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'All converters', path: '/converters/' }]),
  ]}
>
  <h1 class="display text-4xl sm:text-5xl">All <span class="mark">converters</span></h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">
    {TOOLS.length} free converters, grouped by what they work on. They run in your browser, so your files are not uploaded. A few live on sister sites and are marked with an arrow.
  </p>
  <nav aria-label="Groups" class="mt-4 flex flex-wrap gap-2">
    {TOOL_GROUPS.map((g) => <a class="chip" href={`#${g.replace(/\W+/g, '-').toLowerCase()}`}>{GROUP_EMOJI[g]} {g}</a>)}
  </nav>
  {
    TOOL_GROUPS.map((group) => (
      <section class="mt-10" aria-labelledby={group.replace(/\W+/g, '-').toLowerCase()}>
        <h2 id={group.replace(/\W+/g, '-').toLowerCase()} class="text-2xl font-black tracking-tight">{GROUP_EMOJI[group]} {group}</h2>
        <ul class="card-grid mt-3">
          {toolsInGroup(group).map((tool) => (
            <li>
              <a href={hrefFor(tool)} class="card card-link h-full p-4" {...(tool.site ? { rel: 'noopener' } : {})}>
                <span class="flex items-center gap-2.5 text-[17px] font-black">
                  <span aria-hidden="true" class="text-[28px] leading-none">{tool.emoji}</span>
                  {tool.name}
                </span>
                <span class="mt-1 block text-sm leading-[19px] text-muted">{tool.summary}</span>
                {tool.site && <span class="pill mt-2 w-fit">on {tool.site} ↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="mt-10 text-muted">Looking for PDF conversions? They live on <a class="link" href="https://iduckpdf.com/" rel="noopener">iDuckPDF</a>.</p>
</AppShell>
