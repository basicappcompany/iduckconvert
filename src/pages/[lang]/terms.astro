---
import CommunityPage from '../../components/CommunityPage.astro';
import { OTHER_LOCALES, localeByPath } from '../../i18n';

export function getStaticPaths() {
  return OTHER_LOCALES.map((locale) => ({ params: { lang: locale.path } }));
}

const { lang } = Astro.params as { lang: string };
---

<CommunityPage slug="terms" locale={localeByPath(lang)!.code} />
