---
/**
 * A converter page in another language: /es/mp4-to-mp3/, /pt-br/csv-to-json/ and so on. One page per language and
 * converter, with the same interactive converter as the English page. A popular unit pair (cm to inches) has a page
 * in a language once every sentence of it is translated (src/i18n/pages).
 */
import LocalizedToolLayout from '../../components/LocalizedToolLayout.astro';
import ToolIsland from '../../components/ToolIsland.astro';
import { PAGE_TOOLS, GROUP_EMOJI, type ToolLink } from '../../lib/tools';
import { UNIT_PAIRS } from '../../lib/unit-pages';
import { OTHER_LOCALES, localeByPath, pairHasText, runLabelFor } from '../../i18n';

export function getStaticPaths() {
  // A pair is a unit converter with its own page; the same shape the English page builds.
  const pairTool = (slug: string, set: string, name: string): ToolLink => ({ slug, name, summary: '', group: 'Units', emoji: GROUP_EMOJI.Units, kind: 'units', units: set, quick: '', keywords: slug });
  return OTHER_LOCALES.flatMap((locale) => [
    ...PAGE_TOOLS.map((tool) => ({ params: { lang: locale.path, slug: tool.slug }, props: { tool, pair: undefined } })),
    ...UNIT_PAIRS.filter((pair) => pairHasText(locale.code, pair.slug)).map((pair) => ({
      params: { lang: locale.path, slug: pair.slug },
      props: { tool: pairTool(pair.slug, pair.set, pair.slug.replace(/-/g, ' ')), pair },
    })),
  ]);
}

const { lang } = Astro.params as { lang: string };
const { tool, pair } = Astro.props;
const locale = localeByPath(lang)!;
const noFiles = ['units', 'bases', 'words', 'roman', 'case', 'colour', 'timezone', 'dates'].includes(tool.kind);
---

<LocalizedToolLayout tool={tool} locale={locale.code} usesFiles={!noFiles} {...(pair ? { pair } : {})}>
  <ToolIsland tool={tool} runLabel={runLabelFor(locale.code, tool)} pair={pair} />
</LocalizedToolLayout>
