---
import CommunityLayout from '../components/CommunityLayout.astro';
import { PAGE_TOOLS, TOOLS, toolPath } from '../lib/tools';

const upcoming = [
  { emoji: '🇹🇷', title: 'Turkish language', text: 'The whole site in Turkish, with a language switch next to the theme button.' },
  { emoji: '🌀', title: 'Animated WEBP to GIF', text: 'Keep every frame of an animated WEBP, not just the first.' },
  { emoji: '💱', title: 'Currency converter', text: 'Only if we can find a free, reliable rate source that needs no key, and we will show when the rates were last updated.' },
  { emoji: '🎚️', title: 'More audio and video options', text: 'Choose sample rate, channels and exact video size where it helps.' },
];
---

<CommunityLayout
  title={`Roadmap: ${PAGE_TOOLS.length} converters live, what is next | iDuckConvert`}
  description={`iDuckConvert has ${PAGE_TOOLS.length} free converters live today, with more on the way. See what is live and what we are thinking about next.`}
  before="What's"
  mark="next"
  intro={`${PAGE_TOOLS.length} converters are live today. Tell us what matters to you and that is what moves up.`}
>
  <section class="card p-5" style="background: var(--d-duck); color: var(--d-duckink)" aria-labelledby="live">
    <h2 id="live" class="text-2xl font-black">Already live: {PAGE_TOOLS.length} converters</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        PAGE_TOOLS.map((t) => (
          <li>
            <a href={toolPath(t.slug)} class="pill no-underline hover:underline" style="background: var(--d-card); color: var(--d-ink)">
              <span aria-hidden="true">{t.emoji}</span>
              {t.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm">All of these run in your browser, so your files are not uploaded.</p>
  </section>

  <section class="card p-5" aria-labelledby="links">
    <h2 id="links" class="text-2xl font-black tracking-tight">On our sister sites</h2>
    <p class="mt-1 text-sm text-muted">We link to these instead of copying them, so each tool has one good home.</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        TOOLS.filter((t) => t.site).map((t) => (
          <li><a class="pill no-underline hover:underline" href={t.href} rel="noopener">{t.emoji} {t.name} on {t.site} ↗</a></li>
        ))
      }
      <li><a class="pill no-underline hover:underline" href="https://iduckpdf.com/" rel="noopener">📚 All PDF conversions on iDuckPDF ↗</a></li>
    </ul>
  </section>

  <section aria-labelledby="next">
    <h2 id="next" class="text-2xl font-black tracking-tight">Up next</h2>
    <p class="mt-1 text-sm text-muted">None of it is promised: what you ask for decides what moves up.</p>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        upcoming.map((u) => (
          <li class="card p-4">
            <h3 class="text-lg font-black"><span aria-hidden="true">{u.emoji}</span> {u.title}</h3>
            <p class="mt-1 text-sm text-muted">{u.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card p-5">
    <h2 class="text-2xl font-black">Missing something?</h2>
    <p class="mt-1 text-muted">A converter you need, or a way an existing one could work better.</p>
    <p class="mt-3 flex flex-wrap gap-3">
      <a href="/request/" class="btn btn-primary btn-lg">Request a feature</a>
      <a href="/feedback/" class="btn btn-lg">Send feedback</a>
    </p>
  </section>
</CommunityLayout>
