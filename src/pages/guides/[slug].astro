---
import AppShell from '../../components/AppShell.astro';
import { GUIDES, guidePath } from '../../lib/guides';
import { hrefFor, toolBySlug } from '../../lib/tools';
import { articleLd, breadcrumbLd, faqLd, howToLd } from '../../lib/seo';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const tools = guide.tools.map((s) => toolBySlug(s)!).filter(Boolean);
const rest = GUIDES.filter((g) => g.slug !== guide.slug);
const others = [...rest.filter((g) => g.category === guide.category), ...rest.filter((g) => g.category !== guide.category)].slice(0, 3);
const path = guidePath(guide.slug);
---

<AppShell
  title={`${guide.title} | iDuckConvert`}
  description={guide.description}
  jsonLd={[
    articleLd({ headline: guide.title, description: guide.description, path, datePublished: guide.published, dateModified: guide.updated }),
    howToLd(guide.title, guide.steps),
    faqLd(guide.faqs),
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'How-to guides', path: '/guides/' }, { name: guide.title, path }]),
  ]}
>
  <p class="eyebrow"><a href="/guides/" class="underline decoration-2 underline-offset-2">How-to guides</a></p>
  <h1 class="display mt-2 text-3xl min-[400px]:text-4xl sm:text-5xl [overflow-wrap:anywhere]">{guide.title}</h1>
  <p class="mt-3 text-sm text-muted">Updated {guide.updated}</p>
  <section class="card mt-5 p-4" aria-label="Quick answer">
    <p class="eyebrow">Quick answer</p>
    <p class="mt-1 leading-relaxed">{guide.intro}</p>
  </section>

  <div class="prose mt-8">
    <h2>Steps</h2>
    <ol>{guide.steps.map((s) => <li>{s}</li>)}</ol>
    {guide.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        {s.paragraphs.map((p) => <p>{p}</p>)}
      </>
    ))}
  </div>

  <section class="mt-10" aria-label="Try it">
    <h2 class="text-2xl font-black tracking-tight">Try it now</h2>
    <ul class="mt-3 grid gap-4 sm:grid-cols-3">
      {tools.map((t) => (
        <li>
          <a href={hrefFor(t)} class="card card-link h-full p-4" {...(t.site ? { rel: 'noopener' } : {})}>
            <span class="flex items-center gap-2 text-lg font-black"><span aria-hidden="true">{t.emoji}</span>{t.name}</span>
            <span class="mt-1 block text-sm text-muted">{t.summary}</span>
            {t.site && <span class="pill mt-2 w-fit">on {t.site} ↗</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10" aria-labelledby="faq">
    <h2 id="faq" class="text-2xl font-black tracking-tight">Questions</h2>
    <div class="mt-3 grid gap-3">
      {guide.faqs.map((f) => (
        <details class="card px-4 py-3">
          <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
          <p class="mt-2 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-10" aria-label="More guides">
    <h2 class="text-2xl font-black tracking-tight">More guides</h2>
    <ul class="mt-3 grid gap-4 sm:grid-cols-3">
      {others.map((g) => (
        <li><a href={guidePath(g.slug)} class="card card-link h-full p-4"><span class="block text-[17px] font-black">{g.title}</span></a></li>
      ))}
    </ul>
  </section>
</AppShell>
