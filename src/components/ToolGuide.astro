---
/** The written guide under a tool: numbered steps, short notes and common questions. */
interface Props {
  title: string;
  steps: string[];
  notes?: string[];
  faqs: { q: string; a: string }[];
}
const { title, steps, notes = [], faqs } = Astro.props;
---

<section class="prose">
  <h2>{title}</h2>
  <ol>
    {steps.map((step) => <li>{step}</li>)}
  </ol>
  {notes.map((note) => <p class="mt-3 text-sm">{note}</p>)}
  <h2 class="mt-8">Common questions</h2>
  <div class="mt-4 grid gap-3">
    {
      faqs.map((f) => (
        <details class="card px-4 py-3">
          <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
          <p class="mt-2 leading-relaxed">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
