---
import AppShell from './AppShell.astro';
import { PAGE_TOOLS, relatedTools, hrefFor, type ToolLink } from '../lib/tools';
import { contentFor, pairContent } from '../lib/content';
import { MEDIA_PAGES } from '../lib/media-pages';
import { guideForTool, guidePath } from '../lib/guides';
import { breadcrumbLd, faqLd, howToLd, webApplicationLd } from '../lib/seo';
import { LAST_REVIEWED_TEXT } from '../lib/site';
import { UNIT_PAIRS, bighaRows, type UnitPair } from '../lib/unit-pages';
import { alternatesFor } from '../i18n';

interface Props {
  tool: ToolLink;
  /** False for calculators that take no file, so the "files never leave your device" line is left out. */
  usesFiles?: boolean;
  /** A popular unit pair such as cm to inches: it has its own page, text and table. */
  pair?: UnitPair;
}
const { tool, usesFiles = true, pair } = Astro.props;
const content = pair ? pairContent(pair) : contentFor(tool);
const media = MEDIA_PAGES[tool.slug];
const pairName = pair ? pair.slug.replace(/-/g, ' ') : '';
const related = pair
  ? UNIT_PAIRS.filter((p) => p.set === pair.set && p.slug !== pair.slug).slice(0, 3).map((p) => ({ href: `/${p.slug}/`, emoji: tool.emoji, name: p.slug.replace(/-/g, ' '), summary: `Exact factor and table of common values.` }))
    .concat([])
  : relatedTools(tool).map((m) => ({ href: hrefFor(m), emoji: m.emoji, name: m.name, summary: m.summary }));
const guide = pair ? undefined : guideForTool(tool.slug);
const path = `/${tool.slug}/`;
const heading = pair ? `Convert ${pairName}` : /converter|fixer|generator|chunker|^compress|^trim/i.test(tool.name) ? tool.name : `${tool.name} converter`;
const title = pair
  ? `Convert ${pairName}: exact factor and table | iDuckConvert`
  : media
    ? `${tool.name}: ${media.hook} | iDuckConvert`
    : `${heading}: free, in your browser | iDuckConvert`;
const description = pair
  ? `${content.unit!.factor} Free ${pairName} converter with a table of common values. Runs in your browser; nothing is sent anywhere.`.slice(0, 160)
  : media
    ? media.description
    : `${tool.summary} Free, no sign-up, no watermark${usesFiles ? ', and your files are never uploaded' : ''}.`.replace(/\.\s+Free/, '. Free');
const trail = [
  { name: 'Home', path: '/' },
  { name: tool.group, path: '/converters/' },
  ...(pair ? [{ name: 'Units', path: `/${PAGE_TOOLS.find((t) => t.units === pair.set)?.slug ?? 'converters'}/` }] : []),
  { name: heading, path },
];
const jsonLd = [
  webApplicationLd(heading, path, description),
  breadcrumbLd(trail),
  howToLd(`How to use the ${pair ? pairName : tool.name} converter`, content.steps),
  faqLd(content.faqs),
];
/** Lower-case a tool name for the middle of a sentence, but keep acronyms such as QR, JSON and UUID as they are. */
const inSentence = (name: string): string => name.split(' ').map((w) => (/[A-Z].*[A-Z]/.test(w) ? w : w.toLowerCase())).join(' ');
const stepsHeading = pair ? `How do I convert ${pairName}?` : / to /.test(tool.name) ? `How do I convert ${tool.name}?` : `How do I use the ${inSentence(tool.name)} tool?`;
const unit = content.unit;
const mainUnitPage = pair ? PAGE_TOOLS.find((t) => t.units === pair.set) : undefined;
---

<AppShell title={title} description={description} jsonLd={jsonLd} alternates={alternatesFor(path)}>
  <p class="eyebrow">
    <a href="/" class="underline decoration-2 underline-offset-2">Home</a>
    <span aria-hidden="true"> / </span>
    <a href="/converters/" class="underline decoration-2 underline-offset-2">{tool.group}</a>
    {mainUnitPage && <><span aria-hidden="true"> / </span><a href={`/${mainUnitPage.slug}/`} class="underline decoration-2 underline-offset-2">{mainUnitPage.name}</a></>}
  </p>
  <h1 class="display mt-2 flex items-center gap-3 text-[2rem] min-[400px]:text-4xl sm:text-5xl">
    <span aria-hidden="true" class="shrink-0 text-[2rem] min-[400px]:text-4xl sm:text-5xl">{tool.emoji}</span>
    <span class="min-w-0 hyphens-auto [overflow-wrap:anywhere]">{heading}</span>
  </h1>

  <section aria-label="Answer" class="card mt-4 p-4" data-answer>
    <p class="leading-relaxed">{content.answer}</p>
    {
      guide && (
        <p class="mt-2 text-sm">
          <span aria-hidden="true">📖</span> <a class="link" href={guidePath(guide.slug)}>Read the guide: {guide.title}</a>
        </p>
      )
    }
  </section>

  <div class="mt-3 flex flex-wrap gap-2">
    <span class="pill pill-ok">Runs in your browser</span>
    <span class="pill">No sign-up</span>
    <span class="pill">No watermark</span>
    <span class="pill">No ads</span>
  </div>
  {usesFiles && <p class="mt-3 text-sm font-bold">Your files never leave your device.</p>}

  <section class="tool-area mt-5 grid gap-5" aria-label="Converter">
    <slot />
  </section>

  <div class="prose mt-12">
    <h2>{stepsHeading}</h2>
    <ol>
      {content.steps.map((step) => <li>{step}</li>)}
    </ol>
    {
      unit && (
        <>
          <h2>What is the exact factor{pair ? ` for ${pairName}` : ''}?</h2>
          <p class="mt-2 text-lg font-black">{unit.factor}</p>
        </>
      )
    }
    {content.sections.length === 0 && content.about && <><h2>What should I know about {pair ? pairName : inSentence(tool.name)}?</h2><p class="mt-2">{content.about}</p></>}
    {content.sections.map((s) => <><h2>{s.h}</h2><p class="mt-2">{s.p}</p></>)}
  </div>

  {
    unit && (
      <section class="mt-10" aria-labelledby="table">
        <h2 id="table" class="text-2xl font-black tracking-tight">What are some common values?</h2>
        <div class="card mt-3 overflow-x-auto p-4">
          <table class="w-full min-w-[18rem] text-left text-sm">
            <caption class="sr-only">Common {unit.fromLabel} values converted to {unit.toLabel}</caption>
            <thead><tr class="text-muted"><th scope="col" class="pb-2">{unit.fromLabel}</th><th scope="col" class="pb-2">{unit.toLabel}</th></tr></thead>
            <tbody>
              {unit.rows.map((r) => (
                <tr class="border-t border-line/20"><th scope="row" class="py-1.5 pr-3 font-bold tabular-nums">{r.from}</th><td class="py-1.5 tabular-nums">{r.to}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        {
          pair?.slug === 'acre-to-bigha' && (
            <div class="card mt-4 overflow-x-auto p-4">
              <h3 class="text-lg font-black">One acre in the bigha of each state</h3>
              <table class="mt-2 w-full min-w-[18rem] text-left text-sm">
                <thead><tr class="text-muted"><th scope="col" class="pb-2">State</th><th scope="col" class="pb-2">Bigha (sq ft)</th><th scope="col" class="pb-2">Bigha per acre</th></tr></thead>
                <tbody>{bighaRows().map((r) => <tr class="border-t border-line/20"><th scope="row" class="py-1.5 pr-3 font-bold">{r.state}</th><td class="py-1.5 tabular-nums">{r.sqft}</td><td class="py-1.5 tabular-nums">{r.perAcre}</td></tr>)}</tbody>
              </table>
            </div>
          )
        }
        <h3 class="mt-6 text-lg font-black">Where does this factor come from?</h3>
        <p class="mt-1 text-sm leading-relaxed">
          {unit.source.text}
          {unit.source.url && <> <a class="link" href={unit.source.url} rel="noopener">Reference</a></>}
        </p>
        {
          !pair && unit.pairs.length > 0 && (
            <>
              <h3 class="mt-6 text-lg font-black">Popular conversions</h3>
              <ul class="mt-2 flex flex-wrap gap-2">{unit.pairs.map((p) => <li><a class="chip" href={`/${p.slug}/`}>{p.name}</a></li>)}</ul>
            </>
          )
        }
      </section>
    )
  }

  <section class="mt-12" aria-labelledby="faq">
    <h2 id="faq" class="text-3xl font-black tracking-tight">Common questions about {pair ? pairName : inSentence(tool.name)}</h2>
    <div class="mt-4 grid gap-3">
      {
        content.faqs.map((f) => (
          <details class="card px-4 py-3">
            <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
            <p class="mt-2 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  {
    related.length > 0 && (
      <nav class="mt-12" aria-label={`More ${tool.group}`} data-more-nav>
        <h2 class="text-2xl font-black tracking-tight">More in {tool.group}</h2>
        <ul class="mt-3 grid gap-4 sm:grid-cols-3">
          {related.map((mate) => (
            <li>
              <a href={mate.href} class="card card-link h-full p-4">
                <span class="flex items-center gap-2 text-lg font-black">
                  <span aria-hidden="true">{mate.emoji}</span>
                  {mate.name}
                </span>
                <span class="mt-1 block text-sm text-muted">{mate.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <p class="mt-10 text-sm text-muted">Last reviewed: {LAST_REVIEWED_TEXT}. How we work: <a class="link" href="/how-it-works/">see how our converters work</a>.</p>
</AppShell>
