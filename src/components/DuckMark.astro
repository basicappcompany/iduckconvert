---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---

<!-- The iDuck mascot. The outline follows the theme so it shows in dark mode too. -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={className}
  role="img"
  aria-label="iDuck mascot"
>
  <g stroke="var(--d-line)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path
      d="M8 40c0-8 6-12 14-12h6c-2-12 4-20 14-20s14 8 10 16l8 4-8 4c0 12-10 22-24 22-12 0-20-4-20-14z"
      fill="#ffd23f"></path>
    <path d="M44 24l11 4-11 4z" fill="#ff8a1f"></path>
    <path d="M18 40c4 6 14 6 18-2" fill="none"></path>
  </g>
  <circle cx="43" cy="19" r="2.6" fill="#000"></circle>
</svg>
