---
/**
 * A converter page in another language (/es/mp4-to-mp3/ and so on). It shows what is translated so far: the
 * heading, the short answer, the trust line, the converter itself (shared controls and run buttons translated)
 * and links to related converters. The longer explanation, the steps, the table and the questions are English-only
 * for now, so they are left off these pages rather than shown in English under a translated address.
 */
import AppShell from './AppShell.astro';
import { hrefFor, relatedTools, type ToolLink } from '../lib/tools';
import { alternatesFor, dictFor, format, localeByCode, localePath, toolText } from '../i18n';
import { breadcrumbLd, webApplicationLd } from '../lib/seo';
import { guideForTool } from '../lib/guides';
import { guideTextFor } from '../i18n/guides';

interface Props {
  tool: ToolLink;
  locale: string;
  /** False for calculators that take no file, so the "files never leave your device" line is left out. */
  usesFiles?: boolean;
}
const { tool, locale, usesFiles = true } = Astro.props;
const loc = localeByCode(locale);
const d = dictFor(locale);
const lp = (p: string) => localePath(locale, p);
const text = toolText(locale, tool);
const path = `/${tool.slug}/`;
const heading = text.name;
const title = format(d.titleTool, { name: heading });
const description = format(usesFiles ? d.descFiles : d.descNoFiles, { summary: text.summary }).slice(0, 200);
const groupName = d.groups[tool.group];
const trail = [
  { name: d.breadcrumbHome, path: lp('/') },
  { name: groupName, path: lp('/') },
  { name: heading, path: lp(path) },
];
const jsonLd = [webApplicationLd(heading, lp(path), description, loc.hreflang), breadcrumbLd(trail)];
const related = relatedTools(tool).map((m) => ({ href: lp(hrefFor(m)), emoji: m.emoji, name: toolText(locale, m).name, summary: toolText(locale, m).summary }));
const machine = loc.status === 'machine';
const englishGuide = guideForTool(tool.slug);
const guideText = englishGuide ? guideTextFor(locale, englishGuide.slug) : undefined;
---

<AppShell locale={locale} alternates={alternatesFor(path)} title={title} description={description} jsonLd={jsonLd}>
  <p class="eyebrow">
    <a href={lp('/')} class="underline decoration-2 underline-offset-2">{d.breadcrumbHome}</a>
    <span aria-hidden="true"> / </span>
    <span>{groupName}</span>
  </p>
  <h1 class="display mt-2 flex items-center gap-3 text-[2rem] min-[400px]:text-4xl sm:text-5xl">
    <span aria-hidden="true" class="shrink-0 text-[2rem] min-[400px]:text-4xl sm:text-5xl">{tool.emoji}</span>
    <span class="min-w-0 hyphens-auto [overflow-wrap:anywhere]">{heading}</span>
  </h1>

  <section aria-label={d.answerLabel} class="card mt-4 p-4" data-answer>
    <p class="leading-relaxed">{text.quick}</p>
    {
      englishGuide && guideText && (
        <p class="mt-2 text-sm">
          <span aria-hidden="true">📖</span> <a class="link" href={lp(`/guides/${englishGuide.slug}/`)}>{format(d.readGuide, { title: guideText.title })}</a>
        </p>
      )
    }
  </section>

  <div class="mt-3 flex flex-wrap gap-2">
    <span class="pill pill-ok">{d.runsInBrowser}</span>
    <span class="pill">{d.noSignup}</span>
    <span class="pill">{d.noWatermark}</span>
    <span class="pill">{d.noAds}</span>
  </div>
  {usesFiles && <p class="mt-3 text-sm font-bold">{d.filesNeverLeave}</p>}

  <section class="tool-area mt-5 grid gap-5" aria-label={d.converterLabel}>
    <slot />
  </section>

  {machine && <p class="mt-6 text-sm text-muted" data-machine-note>{d.machineNote} {d.controlsEnglish}</p>}

  {
    related.length > 0 && (
      <nav class="mt-12" aria-label={format(d.moreIn, { group: groupName })} data-more-nav>
        <h2 class="text-2xl font-black tracking-tight">{format(d.moreIn, { group: groupName })}</h2>
        <ul class="mt-3 grid gap-4 sm:grid-cols-3">
          {related.map((mate) => (
            <li>
              <a href={mate.href} class="card card-link h-full p-4">
                <span class="flex items-center gap-2 text-lg font-black">
                  <span aria-hidden="true">{mate.emoji}</span>
                  {mate.name}
                </span>
                <span class="mt-1 block text-sm text-muted">{mate.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</AppShell>
