---
/**
 * One of the four long community pages (About, Privacy, Terms, How it works) in any language. The English text lives
 * in src/lib/community-pages.ts; a translation is looked up by the English sentence (src/i18n/pages), so the English
 * page and every language share one layout and cannot drift apart.
 */
import CommunityLayout from './CommunityLayout.astro';
import Inline from './Inline.astro';
import pkg from '../../package.json';
import { ENGINE_HEAD, ENGINE_ROWS, communityPage, type CPage } from '../lib/community-pages';
import { fillVars, plainText } from '../lib/inline';
import { CONTACT_EMAIL, FEEDBACK_EMAIL } from '../lib/contact';
import { LAST_REVIEWED_TEXT } from '../lib/site';
import { breadcrumbLd } from '../lib/seo';
import { PAGE_TOOLS } from '../lib/tools';
import { FFMPEG_CORE_VERSION, WASM_CDN_HOST, WASM_SHA384 } from '../tools/ffmpeg';
import { COMMUNITY_TRANSLATED, alternatesFor, dictFor, localeByCode, localePath } from '../i18n';
import { translationFor } from '../i18n/pages';

interface Props {
  slug: CPage['slug'];
  locale?: string;
}
const { slug, locale = 'en' } = Astro.props;
const page = communityPage(slug);
const loc = localeByCode(locale);
const d = dictFor(locale);
const english = locale === 'en';
const tr = (s: string): string => (english ? s : (translationFor(locale, s) ?? s));
const deps = pkg.dependencies as Record<string, string>;
const host = WASM_CDN_HOST.replace('https://', '');
const dateText = (iso: string): string => new Date(`${iso}T00:00:00Z`).toLocaleDateString(english ? 'en-GB' : loc.hreflang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const vars: Record<string, string | number> = {
  n: PAGE_TOOLS.length,
  feedbackEmail: FEEDBACK_EMAIL,
  contactEmail: CONTACT_EMAIL,
  host,
  core: FFMPEG_CORE_VERSION,
  sha: WASM_SHA384,
  wrapper: deps['@ffmpeg/ffmpeg']!,
  ...Object.fromEntries(['js-yaml', 'marked', 'turndown', 'fast-xml-parser', 'utif2', 'gifenc', 'jszip'].map((k) => [k, deps[k]!])),
  date: page.updated ? dateText(page.updated) : LAST_REVIEWED_TEXT,
};
// How it works says when it was last reviewed with the same date text, in the page language.
if (!page.updated) vars.date = dateText('2026-11-13');
const text = (s: string): string => fillVars(tr(s), vars);
const href = (path: string): string => ((COMMUNITY_TRANSLATED as readonly string[]).includes(path) || path === '/guides/' ? localePath(locale, path) : path);
const here = `/${slug}/`;
const homeName = english ? 'Home' : d.breadcrumbHome;
const jsonLd = slug === 'how-it-works' ? [breadcrumbLd([{ name: homeName, path: localePath(locale, '/') }, { name: `${text(page.before)} ${text(page.mark)}`, path: localePath(locale, here) }])] : [];
---

<CommunityLayout
  title={plainText(text(page.title))}
  description={plainText(text(page.description))}
  before={text(page.before)}
  mark={text(page.mark)}
  intro={plainText(text(page.intro))}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternatesFor(here)}
>
  {page.sections.map((s) => (
    <section class="card p-5" aria-labelledby={s.id}>
      <h2 id={s.id} class="text-2xl font-black tracking-tight">{text(s.h)}</h2>
      {s.blocks.map((b) =>
        'p' in b ? (
          <p class={b.small ? 'mt-3 text-sm text-muted' : 'mt-2 leading-relaxed'}><Inline text={text(b.p)} href={href} /></p>
        ) : 'ul' in b ? (
          <ul class="mt-2 list-disc space-y-1 pl-6 leading-relaxed">
            {b.ul.map((li) => <li><Inline text={text(li)} href={href} /></li>)}
          </ul>
        ) : (
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[34rem] text-left text-sm">
              <thead><tr class="text-muted">{ENGINE_HEAD.map((h) => <th scope="col" class="pb-2">{text(h)}</th>)}</tr></thead>
              <tbody>
                {ENGINE_ROWS.map((r) => <tr class="border-t border-line/20 align-top"><th scope="row" class="py-2 pr-3 font-bold">{text(r.what)}</th><td class="py-2 pr-3">{r.lib}</td><td class="py-2 pr-3 tabular-nums">{text(r.version)}</td><td class="py-2">{text(r.where)}</td></tr>)}
              </tbody>
            </table>
          </div>
        ),
      )}
    </section>
  ))}
  {!english && <p class="text-sm text-muted" data-machine-note>{d.machineShort}</p>}
</CommunityLayout>
